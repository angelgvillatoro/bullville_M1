{
  "C_Cpp.intelliSenseEngine": "default",

  // Rutas ESP-IDF (MAC)
  "idf.espIdfPath": "/Users/bullville/esp/v5.5.1/esp-idf",
  "idf.pythonInstallPath": "/opt/homebrew/bin/python3",
  "idf.toolsPath": "/Users/bullville/.espressif",

  // Target que estás usando
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32s3"
  },

  // Para que el plugin de ESP-IDF configure IntelliSense
  "C_Cpp.default.configurationProvider": "espressif.esp-idf-vscode-extension",

  // Para que C/C++ coja las rutas de compilación reales
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",

  "C_Cpp.errorSquiggles": "enabled",
  "idf.flashType": "UART",
  "idf.port": "/dev/tty.debug-console"
}
